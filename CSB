local function setupChatListener()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.MessageReceived:Connect(function(message)
            if message.TextSource and message.TextSource.UserId == player.UserId then
                if message.Text == ".typo" then
                    state.typosEnabled = not state.typosEnabled
                    local status = state.typosEnabled and "enabled" or "disabled"
                    ConsoleText.Text = "Typos " .. status
                    task.wait(2)
                    ConsoleText.Text = state.lastWord ~= "" and state.lastWord or "Waiting..."
                end
            end
        end)
    else
        player.Chatted:Connect(function(msg)
            if msg == ".typo" then
                state.typosEnabled = not state.typosEnabled
                local status = state.typosEnabled and "enabled" or "disabled"
                ConsoleText.Text = "Typos " .. status
                task.wait(2)
                ConsoleText.Text = state.lastWord ~= "" and state.lastWord or "Waiting..."
            end
        end)
    end
end

