local function handleCommand(msg)
    local args = msg:split(" ")
    local cmd = args[1]:lower()
    local prefix = "C:\\Users\\" .. player.DisplayName .. "> "
    
    local function getBool()
        if args[2] == "true" or args[2] == "on" then return true
        elseif args[2] == "false" or args[2] == "off" then return false
        end
        return nil
    end

    if cmd == ".helpx" then
        addCmdLine("--- AVAILABLE COMMANDS ---")
        addCmdLine(".typo [true/false] - Toggle typos")
        addCmdLine(".typochance [num] - Set typo chance %")
        addCmdLine(".die [true/false] - Toggle instant fail mode")
        addCmdLine(".diechance [num] - Set fail chance %")
        addCmdLine(".autotype [true/false] - Toggle AutoType")
        addCmdLine(".cls - Clear console")
    elseif cmd == ".typo" then
        local b = getBool()
        state.typosEnabled = (b ~= nil) and b or not state.typosEnabled
        addCmdLine(prefix .. "Typos: " .. tostring(state.typosEnabled))
    elseif cmd == ".die" then
        local b = getBool()
        state.dieMode = (b ~= nil) and b or not state.dieMode
        addCmdLine(prefix .. "Die Mode: " .. tostring(state.dieMode))
    elseif cmd == ".autotype" then
        local b = getBool()
        state.autoType = (b ~= nil) and b or not state.autoType
        addCmdLine(prefix .. "AutoType: " .. tostring(state.autoType))
    elseif cmd == ".typochance" and args[2] then
        state.typoChance = tonumber(args[2]) or state.typoChance
        addCmdLine(prefix .. "Typo Chance: " .. state.typoChance .. "%")
    elseif cmd == ".diechance" and args[2] then
        state.dieChance = tonumber(args[2]) or state.dieChance
        addCmdLine(prefix .. "Die Chance: " .. state.dieChance .. "%")
    elseif cmd == ".cls" then
        for _,v in pairs(CmdScroll:GetChildren()) do if v:IsA("TextLabel") then v:Destroy() end end
    end
end

CmdInputBox.FocusLost:Connect(function(enter)
    if enter then
        local t = CmdInputBox.Text
        if t ~= "" then
            addCmdLine("C:\\Users\\" .. player.DisplayName .. "> " .. t)
            handleCommand(t)
        end
        CmdInputBox.Text = ""
        task.wait()
        CmdInputBox:CaptureFocus()
    end
end)

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(m) if m.TextSource.UserId == player.UserId then handleCommand(m.Text) end end)
else
