UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
        menuVisible = not menuVisible
        if menuVisible then
            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.3), {Size = UDim2.new(0, 340, 0, 510), BackgroundTransparency = 0}):Play()
        else
            TweenService:Create(Main, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
            task.wait(0.1)
            Main.Visible = false
        end
    end
end)

local function getPlayerTextbox()
    if not playerGui then return nil end
    local success, gui = pcall(function() return playerGui:FindFirstChild("Textbox") end)
    if success and gui then
        local tb = gui:FindFirstChild("TextBox")
        if tb and tb:IsA("TextBox") then return tb end
    end
    for _, d in ipairs(playerGui:GetDescendants()) do
        if d:IsA("TextBox") and d.Visible and d.Active then return d end
    end
    return nil
end

local function sayWord(word)
    local msg = "word : " .. word
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync(msg) end
        else
            local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvent then chatEvent:FindFirstChild("SayMessageRequest"):FireServer(msg, "All") end
        end
    end)
end

local function completeWord(targetTextbox)
    targetTextbox:ReleaseFocus()
    local success, err = pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("SpelledCorrectly") or ReplicatedStorage:FindFirstChild("CorrectSpelling")
        if remote then remote:FireServer() end
    end)
end

local function getTypoChar(char)
    local lowerChar = string.lower(char)
    if nearbyKeys[lowerChar] then
        local nearby = nearbyKeys[lowerChar]
        return nearby[math.random(1, #nearby)]
    end
    return char
end

local function shouldMakeTypo()
    return state.typosEnabled and math.random(1, 100) <= 15
end

wordValue:GetPropertyChangedSignal("Value"):Connect(function()
    local newWord = wordValue.Value
    
    if newWord ~= "" then
        ConsoleText.Text = newWord
    else
        ConsoleText.Text = "Waiting..."
    end
    
    if newWord == "" then return end
    state.lastWord = newWord

    if state.autoSay then
        task.spawn(function() sayWord(newWord) end)
    end

    task.wait(1)

    if state.autoType then
        local targetTextbox = getPlayerTextbox()
        
        if targetTextbox then
            if state.randomSpeed == false and state.speed == 0 then
                targetTextbox.Text = newWord
                completeWord(targetTextbox)
                return
            end

            local wordLength = string.len(newWord)
            local count = 0
            
            for i = 1, wordLength do
                if not state.autoType or wordValue.Value ~= newWord then break end
                
                local currentDelay = state.speed
                
                if state.randomSpeed then
                    local min = state.minSpeed
                    local max = state.maxSpeed
                    if min > max then min, max = max, min end
                    
                    local randomFactor = math.random() ^ 0.5
                    currentDelay = min + (randomFactor * (max - min))
                    
                    if math.random(1, 100) <= 8 then
                        currentDelay = currentDelay * (2 + math.random())
                    end
                end
                
                if currentDelay > 0 then
                    task.wait(currentDelay)
                end
                
                count = count + 1
                local currentChar = string.sub(newWord, i, i)
                local displayText = string.sub(newWord, 1, count)
                
                -- Typo logic
                if shouldMakeTypo() and i < wordLength then
                    local typoChar = getTypoChar(currentChar)
                    local typoText = string.sub(newWord, 1, count - 1) .. typoChar
                    targetTextbox.Text = typoText
                    
                    -- Wait a bit before correcting
                    local typoDelay = 0.1 + (math.random() * 0.2)
                    task.wait(typoDelay)
                    
                    -- Backspace effect
                    targetTextbox.Text = string.sub(newWord, 1, count - 1)
                    task.wait(0.05 + (math.random() * 0.1))
                end
                
                targetTextbox.Text = displayText
                
                if i == wordLength then
                    completeWord(targetTextbox)
                    break
                end
            end
        end
    end
end)
