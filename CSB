local function getPlayerTextbox()
	if not playerGui then return nil end

	local success, gui = pcall(function()
		return playerGui:FindFirstChild("Textbox")
	end)
	if not success or not gui then return nil end

	local tb = gui:FindFirstChild("Textbox")
	if not tb then

		for _, v in pairs(gui:GetChildren()) do
			if v:IsA("TextBox") or v:IsA("TextLabel") then
				tb = v
				break
			end
		end
	end

	if tb and tb:IsA("TextLabel") then

		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("TextBox") then
				tb = d
				break
			end
		end
	end
	return tb
end

local function textboxUsable(tb)
	return tb
		and tb.Visible == true
		and tb.Active == true
		and (tb:IsDescendantOf(playerGui))
end

local _turnCheckedOnce = false
local _foundTurnIndicator = false

local function findTurnObject()

	local names = {
		"IsMyTurn", "MyTurn",
		"CurrentTurn", "CurrentPlayer", "TurnPlayer", "PlayerTurn",
		"Turn", "TurnValue", "CurrentTurnPlayer", "ActivePlayer"
	}
	for _, name in ipairs(names) do

		local v = ReplicatedStorage:FindFirstChild(name)
		if v then return v end

		v = workspace:FindFirstChild(name)
		if v then return v end
	end
	return nil
end

local function isMyTurn()

	local turnObj = findTurnObject()
	if turnObj then
		_foundTurnIndicator = true

		if turnObj:IsA("BoolValue") then
			return turnObj.Value == true
		end

		if turnObj:IsA("StringValue") then
			return turnObj.Value == player.Name
		end

		if turnObj:IsA("ObjectValue") and turnObj.Value then

			return turnObj.Value == player or tostring(turnObj.Value) == player.Name
		end

		if turnObj:IsA("IntValue") then
			return turnObj.Value == player.UserId
		end
if turnObj.Value ~= nil then
			return tostring(turnObj.Value) == player.Name
		end
		return false
	end
if not _turnCheckedOnce then
		_turnCheckedOnce = true
	end
	return true
end

task.spawn(function()
	while task.wait(0.01) do
		if state.randomSpeed then
			local range = state.maxSpeed - state.minSpeed
			if range <= 0 then
				state.currentDelay = state.minSpeed
			else
				state.currentDelay = state.minSpeed + (math.random() * range)
			end
		else
			state.currentDelay = state.speed
		end
	end
end)
local function typeWord(word)
	local changeTextEvent = ReplicatedStorage:FindFirstChild("ChangeCurrentText")
	local checkEvent = ReplicatedStorage:FindFirstChild("CorrectSpelling")
	
	if not changeTextEvent then
		warn("ChangeCurrentText remote event not found!")
		return
	end
	
	task.wait(1)
	
	local playerTextbox = getPlayerTextbox()
	if not (textboxUsable(playerTextbox) and isMyTurn()) then return end

	if state.speed <= 0 and not state.randomSpeed then
		pcall(function()
			if playerTextbox then
				playerTextbox.Text = word
			end
			changeTextEvent:FireServer(word)
		end)
		
		task.wait(0.3)
		if checkEvent then
			pcall(function()
				checkEvent:FireServer()
			end)
		end
	else
		for i = 1, #word do
			if not state.autoType or wordValue.Value ~= word then break end
			
			playerTextbox = getPlayerTextbox()
			if not (textboxUsable(playerTextbox) and isMyTurn()) then

				return
			end
			
			local delayTime = state.currentDelay or state.speed
			if delayTime < 0 then delayTime = 0 end
			
			task.wait(delayTime)
			local partial = string.sub(word, 1, i)
			pcall(function()
				if playerTextbox then
					playerTextbox.Text = partial
				end
				changeTextEvent:FireServer(partial)
			end)
		end
		playerTextbox = getPlayerTextbox()
		if playerTextbox then
			pcall(function()
				playerTextbox.Text = word
			end)
		end
	end
end

local function sayWord(word)
	local msg = "word is : " .. word .. "!"
	
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if channel then
				channel:SendAsync(msg)
			end
		else
			local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if chatEvent then
				local sayEvent = chatEvent:FindFirstChild("SayMessageRequest")
				if sayEvent then
					sayEvent:FireServer(msg, "All")
				end
			end
		end
	end)
end

task.spawn(function()
	while task.wait(0.1) do
		if not (ScreenGui and ScreenGui.Parent) then break end
		
		local currentWord = wordValue.Value or ""
		
		if currentWord ~= "" then
			ConsoleText.Text = currentWord
			StatusDot.BackgroundColor3 = Color3.fromRGB(80, 220, 100)
		else
			ConsoleText.Text = "Waiting..."
			StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
		end
		
		if currentWord ~= state.lastWord and currentWord ~= "" then
			state.lastWord = currentWord
			
			if state.autoSay then
				task.spawn(function()
					sayWord(currentWord)
				end)
			end
			if state.autoType then
				local tb = getPlayerTextbox()
				if textboxUsable(tb) and isMyTurn() then
					task.spawn(function()
						typeWord(currentWord)
					end)
				end
			end
		end
	end
end)
