-- // HELPER FUNCTIONS // --

local function getPlayerTextbox()
    if not playerGui then return nil end

    local success, gui = pcall(function()
        return playerGui:FindFirstChild("Textbox")
    end)
    
    if success and gui then
        local tb = gui:FindFirstChild("TextBox")
        if tb and tb:IsA("TextBox") then
            return tb
        end
    end

    for _, d in ipairs(playerGui:GetDescendants()) do
        if d:IsA("TextBox") and d.Visible and d.Active then
            return d
        end
    end

    return nil
end

local function textboxUsable(tb)
    return tb
        and tb.Visible == true
        and tb.Active == true
        and (tb:IsDescendantOf(playerGui))
end

local function sayWord(word)
    local msg = "word is : " .. word .. "!"
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:SendAsync(msg)
            end
        else
            local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvent then
                local sayEvent = chatEvent:FindFirstChild("SayMessageRequest")
                if sayEvent then
                    sayEvent:FireServer(msg, "All")
                end
            end
        end
    end)
end

-- // MAIN LOGIC // --

wordValue:GetPropertyChangedSignal("Value"):Connect(function()
    local newWord = wordValue.Value
    
    -- Update UI Console
    if newWord ~= "" then
        ConsoleText.Text = newWord
        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 220, 100)
    else
        ConsoleText.Text = "Waiting..."
        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
    end
    
    if newWord == "" then return end
    state.lastWord = newWord

    -- Auto Say Logic
    if state.autoSay then
        task.spawn(function()
            sayWord(newWord)
        end)
    end

    -- Auto Type Logic
    task.wait(1)

    if state.autoType then
        local targetTextbox = getPlayerTextbox()
        
        if targetTextbox and textboxUsable(targetTextbox) then
            local wordLength = string.len(newWord)
            local count = 0
            
            for i = 1, wordLength do
                -- Stop if setting turned off or word changed mid-typing
                if not state.autoType or wordValue.Value ~= newWord then break end
                
                -- // CALCULATE DELAY HERE // --
                local currentDelay = state.speed
                
                if state.randomSpeed then
                    -- This ensures a unique random number is picked for EVERY letter
                    local min = state.minSpeed
                    local max = state.maxSpeed
                    -- Safety check to ensure min isn't larger than max
                    if min > max then min, max = max, min end 
                    
                    -- Calculate random delay
                    currentDelay = min + (math.random() * (max - min))
                end
                
                task.wait(currentDelay) 
                
                count = count + 1
                local stringSub = string.sub(newWord, 1, count)
                
                targetTextbox.Text = stringSub
                
                if i == wordLength then
                    targetTextbox:ReleaseFocus()
                    local success, err = pcall(function()
                        local remote = ReplicatedStorage:FindFirstChild("SpelledCorrectly") 
                                    or ReplicatedStorage:FindFirstChild("CorrectSpelling")
                        if remote then
                            remote:FireServer()
                        end
                    end)
                    break
                end
            end
        end
    end
end)
