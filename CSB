end

UserInputService.InputBegan:Connect(function(io, gp)
    if gp then return end
    if io.KeyCode == Enum.KeyCode.Q and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        CmdFrame.Visible = not CmdFrame.Visible
        if CmdFrame.Visible then CmdInputBox:CaptureFocus() end
    elseif io.KeyCode == Enum.KeyCode.LeftControl then
        menuVisible = not menuVisible
        Main.Visible = menuVisible
    end
end)

local function getPlayerTextbox()
    for _, d in ipairs(playerGui:GetDescendants()) do
        if d:IsA("TextBox") and d.Visible and d.Active then return d end
    end
    return nil
end

local function getTypoChar(char)
    local lc = char:lower()
    if nearbyKeys[lc] then return nearbyKeys[lc][math.random(1, #nearbyKeys[lc])] end
    return char
end

wordValue:GetPropertyChangedSignal("Value"):Connect(function()
    local val = wordValue.Value
    ConsoleText.Text = (val ~= "") and val or "Waiting..."
    if val == "" or not state.autoType or state.isTyping then return end

    state.isTyping = true
    task.spawn(function()
        local intended = val
        while state.autoType and wordValue.Value == intended do
            local tb = getPlayerTextbox()
            if not tb then task.wait(0.1) continue end

            if not state.randomSpeed and state.speed == 0 then
                tb.Text = intended
                ReplicatedStorage.SpelledCorrectly:FireServer()
                break
            end

            local cur = ""
            local isDie = state.dieMode and math.random(1,100) <= state.dieChance
            local dieIdx = isDie and math.random(1, #intended) or nil

            for i = 1, #intended do
                if wordValue.Value ~= intended then break end
                local ch = intended:sub(i,i)
                
                if isDie and i == dieIdx then
                    cur = cur .. getTypoChar(ch)
                    tb.Text = cur
                    break
                else
                    if state.typosEnabled and math.random(1,100) <= state.typoChance and i < #intended then
                        tb.Text = cur .. getTypoChar(ch)
                        task.wait(0.12)
                    end
                    cur = cur .. ch
                end
                tb.Text = cur
                task.wait(state.randomSpeed and (state.minSpeed + math.random()*(state.maxSpeed-state.minSpeed)) or state.speed)
            end
            if tb.Text == intended then ReplicatedStorage.SpelledCorrectly:FireServer() end
            break
        end
        state.isTyping = false
    end)
end)
