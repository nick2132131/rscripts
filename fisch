local function setBoatFreeze(v)
    if boatFrConn then boatFrConn:Disconnect() boatFrConn=nil end
    boatFrozenCF = nil
    if not v then return end
    local root = getBoatRoot(getBoat())
    if root then boatFrozenCF = root.CFrame end
    boatFrConn = RunService.Heartbeat:Connect(function()
        if not cfg.BoatFreeze then return end
        local root2 = getBoatRoot(getBoat())
        if root2 and boatFrozenCF then
            root2.CFrame = boatFrozenCF
            root2.AssemblyLinearVelocity  = Vector3.zero
            root2.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function getEventCF(ev)
    local zoneName = ev.hunt and (ev.zone.." Hunt") or ev.zone
    local fz = workspace:FindFirstChild("zones") and workspace.zones:FindFirstChild("fishing")
    if fz then
        local z = fz:FindFirstChild(zoneName) or fz:FindFirstChild(ev.zone)
        if z then
            if z:IsA("BasePart") then return z.CFrame end
            if z:IsA("Model")    then return z:GetPivot() end
            local p = z:FindFirstChildWhichIsA("BasePart") if p then return p.CFrame end
        end
    end
    local function scan(parent, depth)
        if depth > 6 then return nil end
        for _, o in parent:GetChildren() do
            local n = o.Name
            if n==zoneName or n==ev.zone or n==ev.zone.." Hunt" then
                if o:IsA("BasePart") then return o.CFrame end
                if o:IsA("Model")    then return o:GetPivot() end
                local p = o:FindFirstChildWhichIsA("BasePart") if p then return p.CFrame end
            end
            local r = scan(o, depth+1) if r then return r end
        end
    end
    return scan(workspace, 0)
end

local activeEvent, lastEventPos = nil, nil

task.spawn(function()
    while task.wait(7) do
        if not cfg.AutoEvent then
            if activeEvent then cfg.Frozen=false; setFrozen(false); activeEvent=nil; lastEventPos=nil end
            continue
        end
        if activeEvent then
            local cf = getEventCF(activeEvent)
            if cf then
                local newPos = cf.Position
                local moved  = lastEventPos and (newPos-lastEventPos).Magnitude > 2
                if not lastEventPos or moved then
                    cfg.Frozen=false; setFrozen(false)
                    local h = hrp()
                    if h then h.CFrame = cf + Vector3.new(0,30,0) end
                    lastEventPos = newPos
                    task.wait(0.15)
                    cfg.Frozen=true; setFrozen(true)
                end
            else
                cfg.Frozen=false; setFrozen(false)
                notify("event", activeEvent.name.." gone")
                if cfg.EventReturnSlot and slots[cfg.EventReturnSlot] then
                    local h = hrp()
                    if h then
                        h.CFrame = slots[cfg.EventReturnSlot]
                        notify("event","returned to slot "..cfg.EventReturnSlot)
                    end
                end
                activeEvent=nil; lastEventPos=nil
            end
            continue
        end
        for _, ev in EVENTS do
            if not eventEnabled[ev.name] then continue end
            local cf = getEventCF(ev)
            if cf then
                activeEvent=ev; lastEventPos=nil
                notify("event",ev.name)
                if cfg.WHEventStart then sendWebhook("event",ev.name) end
                break
            end
        end
    end
end)

