-- auto shake: check we only look inside shakeui, never touch our own UI
task.spawn(function()
    while task.wait(0.05) do
        if not cfg.AutoShake then continue end
        pcall(function()
            local sg=pgui:FindFirstChild("shakeui")
            if not sg then return end
            -- only recurse inside shakeui, not entire pgui
            for _,desc in sg:GetDescendants() do
                if desc:IsA("TextButton") and desc.Visible and
                   desc.Parent and desc.Parent:IsDescendantOf(sg) then
                    local pos=desc.AbsolutePosition+desc.AbsoluteSize/2
                    VIM:SendMouseButtonEvent(pos.X,pos.Y,0,true, game,1)
                    task.wait(0.02)
                    VIM:SendMouseButtonEvent(pos.X,pos.Y,0,false,game,1)
                    break
                end
            end
        end)
    end
end)

