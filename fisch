local function mkInput(parent, placeholder, default)
    local wrap = Instance.new("Frame", parent)
    wrap.Size=UDim2.new(1,0,0,34); wrap.BackgroundColor3=C.CARD; wrap.BorderSizePixel=0
    corner(wrap,8); local bord=stroke(wrap,C.BORDER)
    local tb = Instance.new("TextBox", wrap)
    tb.Size=UDim2.new(1,-16,1,0); tb.Position=UDim2.new(0,8,0,0)
    tb.BackgroundTransparency=1; tb.Text=default or ""
    tb.PlaceholderText=placeholder; tb.PlaceholderColor3=C.SUB
    tb.Font=Enum.Font.Gotham; tb.TextSize=12
    tb.TextColor3=C.TXT; tb.ClearTextOnFocus=false; tb.BorderSizePixel=0
    tb.Focused:Connect(function()  TS:Create(bord,TweenInfo.new(0.12),{Color=C.ACC}):Play()  end)
    tb.FocusLost:Connect(function() TS:Create(bord,TweenInfo.new(0.12),{Color=C.BORDER}):Play() end)
    return wrap, tb
end

