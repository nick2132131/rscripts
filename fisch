local function getBoat()
    local h=hum() if not h then return nil end
    local seat=h.SeatPart if not seat then return nil end
    local m=seat:FindFirstAncestorWhichIsA("Model")
    return (m and m~=workspace) and m or nil
end

local function getBoatRoot(b)
    if not b then return nil end
    if b.PrimaryPart then return b.PrimaryPart end
    local best,bv=nil,0
    for _,p in b:GetDescendants() do
        if p:IsA("BasePart") then
            local v=p.Size.X*p.Size.Y*p.Size.Z
            if v>bv then best=p; bv=v end
        end
    end
    return best
end

local boatFlyConn, boatNcConn, boatFrConn
local boatFrozenCF, preAnchorStates = nil, {}

local function setBoatFly(v)
    if boatFlyConn then boatFlyConn:Disconnect() boatFlyConn=nil end
    if not v then return end
    boatFlyConn=RunService.Heartbeat:Connect(function(dt)
        if not cfg.BoatFly then return end
        local boat=getBoat(); local root=getBoatRoot(boat); if not root then return end
        local cam=workspace.CurrentCamera; local cf=root.CFrame
        local mv=Vector3.zero
        local lk=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
        local rt=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
        if lk.Magnitude>0 then lk=lk.Unit end; if rt.Magnitude>0 then rt=rt.Unit end
        if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+lk  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-lk  end
        if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-rt  end
        if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+rt  end
        if UIS:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then mv=mv-Vector3.new(0,1,0) end
        if mv.Magnitude>0 then
            root.CFrame=CFrame.new(cf.Position+mv.Unit*cfg.BoatFlySpeed*dt)*(cf-cf.Position)
        end
        root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
        for _,p in boat:GetDescendants() do
            if p:IsA("BasePart") and p~=root then p.AssemblyLinearVelocity=Vector3.zero; p.AssemblyAngularVelocity=Vector3.zero end
        end
    end)
end

local function setBoatNoClip(v)
    if boatNcConn then boatNcConn:Disconnect() boatNcConn=nil end
    if not v then return end
    boatNcConn=RunService.Stepped:Connect(function()
        if not cfg.BoatNoClip then return end
        local b=getBoat() if not b then return end
        for _,p in b:GetDescendants() do if p:IsA("BasePart") and not p.Anchored then p.CanCollide=false end end
    end)
end

local function setBoatFreeze(v)
    if boatFrConn then boatFrConn:Disconnect() boatFrConn=nil end
    boatFrozenCF=nil; if not v then return end
    local r=getBoatRoot(getBoat()) if r then boatFrozenCF=r.CFrame end
    boatFrConn=RunService.Heartbeat:Connect(function()
        if not cfg.BoatFreeze then return end
        local r2=getBoatRoot(getBoat())
        if r2 and boatFrozenCF then r2.CFrame=boatFrozenCF; r2.AssemblyLinearVelocity=Vector3.zero; r2.AssemblyAngularVelocity=Vector3.zero end
    end)
end

local function getEventCF(ev)
    local zn=ev.hunt and (ev.zone.." Hunt") or ev.zone
    local fz=workspace:FindFirstChild("zones") and workspace.zones:FindFirstChild("fishing")
    if fz then
        local z=fz:FindFirstChild(zn) or fz:FindFirstChild(ev.zone)
        if z then
            if z:IsA("BasePart") then return z.CFrame end
            if z:IsA("Model")    then return z:GetPivot() end
            local p=z:FindFirstChildWhichIsA("BasePart") if p then return p.CFrame end
        end
    end
    local function scan(parent,depth)
        if depth>6 then return nil end
        for _,o in parent:GetChildren() do
            local n=o.Name
            if n==zn or n==ev.zone or n==ev.zone.." Hunt" then
                if o:IsA("BasePart") then return o.CFrame end
                if o:IsA("Model")    then return o:GetPivot() end
                local p=o:FindFirstChildWhichIsA("BasePart") if p then return p.CFrame end
            end
            local r=scan(o,depth+1) if r then return r end
        end
    end
    return scan(workspace,0)
end

local activeEvent, lastEventPos=nil,nil

task.spawn(function()
    while task.wait(7) do
        if not cfg.AutoEvent then
            if activeEvent then cfg.Frozen=false; setFrozen(false); activeEvent=nil; lastEventPos=nil end
            continue
        end
        if activeEvent then
            local cf=getEventCF(activeEvent)
            if cf then
                local np=cf.Position
                local moved=lastEventPos and (np-lastEventPos).Magnitude>2
                if not lastEventPos or moved then
                    cfg.Frozen=false; setFrozen(false)
                    local h=hrp() if h then h.CFrame=cf+Vector3.new(0,30,0) end
                    lastEventPos=np; task.wait(0.15)
                    cfg.Frozen=true; setFrozen(true)
                end
            else
                cfg.Frozen=false; setFrozen(false)
                notify("event",activeEvent.name.." gone")
                if cfg.EventReturnSlot and slots[cfg.EventReturnSlot] then
                    local h=hrp()
                    if h then h.CFrame=slots[cfg.EventReturnSlot]; notify("event","returned to slot "..cfg.EventReturnSlot) end
                end
                activeEvent=nil; lastEventPos=nil
            end
            continue
        end
        for _,ev in EVENTS do
            if not eventEnabled[ev.name] then continue end
            local cf=getEventCF(ev)
            if cf then
                activeEvent=ev; lastEventPos=nil
                notify("event",ev.name)
                if cfg.WHEventStart then sendWebhook("event",ev.name) end
                break
            end
        end
    end
end)

