                local moved=not first and (np-lastEventPos).Magnitude>5
                if first or moved then
                    local yOff=HIGH_Y[activeEvent.name] and 50 or 30
                    local dest=CFrame.new(np.X,np.Y+yOff,np.Z); local h=hrp()
                    if h then h.CFrame=dest; frozenCF=dest; if not cfg.Frozen then cfg.Frozen=true; setFrozen(true) end end
                    lastEventPos=np
                end
            else
                local h=hrp()
                if cfg.EventReturnSlot and slots[cfg.EventReturnSlot] and h then
                    if freezeConn then freezeConn:Disconnect(); freezeConn=nil end
                    h.CFrame=slots[cfg.EventReturnSlot]; task.wait(0.05)
                end
                cfg.Frozen=false; if freezeConn then freezeConn:Disconnect(); freezeConn=nil end
                notify("event",activeEvent.name.." gone"); activeEvent=nil; lastEventPos=nil
            end
            continue
        end
        for _,ev in EVENTS do
            if eventEnabled[ev.name] then
                local cf=getEventCF(ev)
                if cf then
                    activeEvent=ev; lastEventPos=nil
                    notify("event",ev.name); sendWebhook("event",ev.name); dbg("event: "..ev.name); break
                end
            end
        end
    end
end)

