local posp=pages["positions"]
secLabel(posp,"save slots  --  double-click to copy")
local slotWrap=Instance.new("Frame",posp); slotWrap.BackgroundTransparency=1
slotWrap.Size=UDim2.new(1,0,0,0); slotWrap.AutomaticSize=Enum.AutomaticSize.Y; vl(slotWrap,4)
local lastClickT={}

local function buildSlot(i)
    local row=mkRow(slotWrap,38); row.LayoutOrder=i
    local nameLbl=Instance.new("TextLabel",row)
    nameLbl.Size=UDim2.new(1,-170,1,0); nameLbl.Position=UDim2.new(0,14,0,0)
    nameLbl.BackgroundTransparency=1; nameLbl.Font=Enum.Font.Gotham; nameLbl.TextSize=11
    nameLbl.TextXAlignment=Enum.TextXAlignment.Left; nameLbl.TextTruncate=Enum.TextTruncate.AtEnd
    local function refreshLbl()
        local name=slotNames[i] or ("slot "..i)
        if slots[i] then
            local p=slots[i].Position
            nameLbl.Text=name.."  "..math.floor(p.X).." "..math.floor(p.Y).." "..math.floor(p.Z)
            nameLbl.TextColor3=GREEN
        else nameLbl.Text=name.."  (empty)"; nameLbl.TextColor3=DIM end
    end
    refreshLbl()
    local renTB=Instance.new("TextBox",row)
    renTB.Name="RenTB"
    renTB.Size=UDim2.new(1,-170,1,0); renTB.Position=UDim2.new(0,14,0,0)
    renTB.BackgroundTransparency=1; renTB.Font=Enum.Font.Gotham; renTB.TextSize=11; renTB.TextColor3=TXT
    renTB.ClearTextOnFocus=false; renTB.PlaceholderText="slot "..i; renTB.PlaceholderColor3=SUB
    renTB.BorderSizePixel=0; renTB.Visible=false; renTB.Text=slotNames[i] or ""
    renTB.FocusLost:Connect(function()
        local t=renTB.Text:match("^%s*(.-)%s*$")
        slotNames[i]=(t~="" and t or nil); renTB.Visible=false; nameLbl.Visible=true
        refreshLbl(); saveSlots()
        if retSlotRefresh then retSlotRefresh() end
    end)
    local function smBtn(xo,txt,col,fn2)
        local b=Instance.new("TextButton",row)
        b.Name="SmBtn"
        b.Size=UDim2.new(0,36,0,26); b.Position=UDim2.new(1,xo,0.5,-13)
        b.BackgroundColor3=col; b.TextColor3=rgb(255,255,255); b.Font=Enum.Font.GothamBold
        b.TextSize=10; b.Text=txt; b.AutoButtonColor=false; b.BorderSizePixel=0; cr(b,6)
        b.MouseButton1Click:Connect(fn2); return b
    end
    smBtn(-158,"[E]",EL2,function()
        nameLbl.Visible=false; renTB.Text=slotNames[i] or ""; renTB.Visible=true; renTB:CaptureFocus()
    end)
    smBtn(-116,"[S]",GREEN,function()
        local h=hrp() if not h then return end
        slots[i]=h.CFrame; refreshLbl(); saveSlots(); notify("pos","slot "..i.." saved")
        if retSlotRefresh then retSlotRefresh() end
    end)
    smBtn(-74,"[L]",CYAN:Lerp(rgb(0,0,0),.45),function()
        if slots[i] then local h=hrp() if h then h.CFrame=slots[i]; notify("pos","slot "..i) end
        else notify("pos","slot "..i.." empty") end
    end)
    local hit=Instance.new("TextButton",row)
    hit.Name="Hit"
    hit.Size=UDim2.new(1,-172,1,0); hit.BackgroundTransparency=1; hit.Text=""
    hit.AutoButtonColor=false; hit.BorderSizePixel=0; hit.ZIndex=row.ZIndex+2
    hit.MouseButton1Click:Connect(function()
        local now=tick()
        if lastClickT[i] and (now-lastClickT[i])<0.4 then
            lastClickT[i]=nil
            local name=slotNames[i] or ("slot "..i)
            if slots[i] then
                local p=slots[i].Position
                local txt=name.." "..math.floor(p.X).." "..math.floor(p.Y).." "..math.floor(p.Z)
                pcall(setclipboard,txt); notify("pos","copied")
            else pcall(setclipboard,name.." (empty)"); notify("pos","copied") end
        else lastClickT[i]=now end
    end)
    row.MouseEnter:Connect(function() tw(row,.08,{BackgroundColor3=ELH}) end)
    row.MouseLeave:Connect(function() tw(row,.08,{BackgroundColor3=EL}) end)
end

for i=1,slotCount do buildSlot(i) end
