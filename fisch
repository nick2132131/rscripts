-- auto-scan dropdown of everything in interactables
local function buildShopList()
    local items={}
    local ints=(workspace:FindFirstChild("world") and workspace.world:FindFirstChild("interactables"))
    if ints then
        for _,v in ints:GetChildren() do
            if v:IsA("Model") or v:IsA("BasePart") then
                table.insert(items,v.Name)
            end
        end
    end
    -- also check workspace root for models
    for _,v in workspace:GetChildren() do
        if (v:IsA("Model") or v:IsA("BasePart")) and v.Name:lower():find("crate","totem","geode","bait") then
            local already=false
            for _,n in items do if n==v.Name then already=true; break end end
            if not already then table.insert(items,v.Name) end
        end
    end
    table.sort(items)
    return items
end

