local slots, slotNames, slotCount = {}, {}, 5

local function saveSlots()
    pcall(function()
        if not writefile then return end
        local t = { count=slotCount }
        for i=1,slotCount do
            if slots[i] then
                local cf=slots[i]
                local _,_,_,r00,r01,r02,r10,r11,r12,r20,r21,r22=cf:GetComponents()
                t[tostring(i)]={x=cf.X,y=cf.Y,z=cf.Z,r00=r00,r01=r01,r02=r02,r10=r10,r11=r11,r12=r12,r20=r20,r21=r21,r22=r22,name=slotNames[i]}
            elseif slotNames[i] then
                t[tostring(i)]={name=slotNames[i]}
            end
        end
        writefile(SLOTS_FILE, HTTP:JSONEncode(t))
    end)
end

local function loadSlots()
    pcall(function()
        if not readfile then return end
        local ok,raw=pcall(readfile,SLOTS_FILE)
        if not ok then return end
        local d=HTTP:JSONDecode(raw)
        if d.count then slotCount=math.max(5,d.count) end
        for i=1,slotCount do
            local s=d[tostring(i)]
            if s then
                if s.r00 then slots[i]=CFrame.new(s.x,s.y,s.z,s.r00,s.r01,s.r02,s.r10,s.r11,s.r12,s.r20,s.r21,s.r22)
                elseif s.x then slots[i]=CFrame.new(s.x,s.y,s.z) end
                slotNames[i]=s.name
            end
        end
        dbg("slots loaded: "..slotCount.." slots")
    end)
end
loadSlots()

