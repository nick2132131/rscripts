local function getBoat()
    local h = hum() if not h then return nil end
    local seat = h.SeatPart
    if not seat then return nil end
    local m = seat:FindFirstAncestorWhichIsA("Model")
    return (m and m ~= workspace) and m or nil
end

local function getBoatRoot(boat)
    if not boat then return nil end
    if boat.PrimaryPart then return boat.PrimaryPart end
    local best, bestV = nil, 0
    for _, p in boat:GetDescendants() do
        if p:IsA("BasePart") then
            local v = p.Size.X * p.Size.Y * p.Size.Z
            if v > bestV then best=p; bestV=v end
        end
    end
    return best
end

local boatFlyConn, boatNcConn, boatFrConn
local boatFrozenCF = nil
local preAnchorStates = {}

local function setBoatFly(v)
    if boatFlyConn then boatFlyConn:Disconnect() boatFlyConn=nil end
    if not v then return end
    boatFlyConn = RunService.Heartbeat:Connect(function(dt)
        if not cfg.BoatFly then return end
        local boat = getBoat(); local root = getBoatRoot(boat)
        if not root then return end
        local cam   = workspace.CurrentCamera
        local cf    = root.CFrame
        local move  = Vector3.zero
        local look  = Vector3.new(cam.CFrame.LookVector.X,  0, cam.CFrame.LookVector.Z)
        local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
        if look.Magnitude  > 0 then look  = look.Unit  end
        if right.Magnitude > 0 then right = right.Unit end
        if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + look  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - look  end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right end
        if UIS:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0,1,0) end
        if move.Magnitude > 0 then
            root.CFrame = CFrame.new(cf.Position + move.Unit * cfg.BoatFlySpeed * dt) * (cf - cf.Position)
        end
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        for _, p in boat:GetDescendants() do
            if p:IsA("BasePart") and p ~= root then
                p.AssemblyLinearVelocity  = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
end

local function setBoatNoClip(v)
