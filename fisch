local posp = pages["positions"]
secLabel(posp,"save slots  ·  double-click to copy",C.YELLOW)

local slotWrap=Instance.new("Frame",posp); slotWrap.BackgroundTransparency=1
slotWrap.Size=UDim2.new(1,0,0,0); slotWrap.AutomaticSize=Enum.AutomaticSize.Y; vlist(slotWrap,4)

local lastClickT={}

local function buildSlotRow(i)
    local row = mkCard(slotWrap, 36)
    row.LayoutOrder=i

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-170,1,0); lbl.Position=UDim2.new(0,14,0,0)
    lbl.BackgroundTransparency=1; lbl.Font=Enum.Font.Gotham; lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextTruncate=Enum.TextTruncate.AtEnd

    local function refreshLbl()
        local name=slotNames[i] or ("slot "..i)
        if slots[i] then
            local p=slots[i].Position
            lbl.Text=name.."  ·  "..math.floor(p.X).." "..math.floor(p.Y).." "..math.floor(p.Z)
            lbl.TextColor3=C.GREEN
        else
            lbl.Text=name.."  ·  empty"; lbl.TextColor3=C.DIM
        end
    end
    refreshLbl()

    local renTB=Instance.new("TextBox",row)
    renTB.Size=UDim2.new(1,-170,1,0); renTB.Position=UDim2.new(0,14,0,0)
    renTB.BackgroundTransparency=1; renTB.Font=Enum.Font.Gotham; renTB.TextSize=11
    renTB.TextColor3=C.TXT; renTB.ClearTextOnFocus=false
    renTB.PlaceholderText="slot "..i; renTB.PlaceholderColor3=C.SUB
    renTB.BorderSizePixel=0; renTB.Visible=false; renTB.Text=slotNames[i] or ""
    renTB.FocusLost:Connect(function()
        local t=renTB.Text:match("^%s*(.-)%s*$")
        slotNames[i]=(t~="" and t or nil); renTB.Visible=false; lbl.Visible=true
        refreshLbl(); saveSlots()
    end)

    local function smBtn(xo,txt,col,fn)
        local b=Instance.new("TextButton",row)
        b.Size=UDim2.new(0,34,0,24); b.Position=UDim2.new(1,xo,0.5,-12)
        b.BackgroundColor3=col; b.TextColor3=C.WHITE
        b.Font=Enum.Font.GothamBold; b.TextSize=10; b.Text=txt
        b.AutoButtonColor=false; b.BorderSizePixel=0; corner(b,6)
        b.MouseButton1Click:Connect(fn); return b
    end
    smBtn(-162,"✎",C.CARD2,function()
        lbl.Visible=false; renTB.Text=slotNames[i] or ""; renTB.Visible=true; renTB:CaptureFocus()
    end)
    smBtn(-122,"save",C.GREEN,function()
        local h=hrp() if not h then return end
        slots[i]=h.CFrame; refreshLbl(); saveSlots(); notify("pos","slot "..i.." saved")
    end)
    smBtn(-82,"load",C.BLUE,function()
        if slots[i] then local h=hrp() if h then h.CFrame=slots[i]; notify("pos","slot "..i) end
        else notify("pos","slot "..i.." empty") end
    end)

    local hit=Instance.new("TextButton",row)
    hit.Size=UDim2.new(1,-168,1,0); hit.Position=UDim2.new(0,0,0,0)
    hit.BackgroundTransparency=1; hit.Text=""; hit.AutoButtonColor=false
    hit.BorderSizePixel=0; hit.ZIndex=row.ZIndex+2
    hit.MouseButton1Click:Connect(function()
        local now=tick()
        if lastClickT[i] and (now-lastClickT[i])<0.4 then
            lastClickT[i]=nil
            local name=slotNames[i] or ("slot "..i)
            if slots[i] then
                local p=slots[i].Position
                local txt=name.." "..math.floor(p.X).." "..math.floor(p.Y).." "..math.floor(p.Z)
                pcall(setclipboard,txt); notify("pos","copied: "..txt)
            else pcall(setclipboard,name.." (empty)"); notify("pos","copied") end
        else lastClickT[i]=now end
    end)
end

for i=1,slotCount do buildSlotRow(i) end
