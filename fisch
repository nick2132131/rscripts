local function httpPost(url, body)
    if     request              then return request({Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
    elseif http and http.request then return http.request({Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
    elseif syn  and syn.request  then return syn.request({Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
    else error("no http function") end
end

local function fmtTime(s)
    s = math.floor(s)
    if s < 60   then return s.."s" end
    if s < 3600 then return math.floor(s/60).."m "..s%60 .."s" end
    return math.floor(s/3600).."h "..math.floor(s%3600/60).."m"
end

local function sendWebhook(kind, extra)
    if not cfg.WHEnabled or cfg.WebhookURL == "" then return end
    task.spawn(function()
        local fields = {}
        if cfg.WHShowPlayer then table.insert(fields,{name="Player",value=lp.Name,inline=true}) end
        if cfg.WHShowLevel  then
            local ls = lp:FindFirstChild("leaderstats")
            local lv = ls and ls:FindFirstChild("Level")
            table.insert(fields,{name="Level",value=tostring(lv and lv.Value or "?"),inline=true})
        end
        if kind=="levelup" then
            if cfg.WHShowCatch then table.insert(fields,{name="Catch #",value=tostring(catchCount),inline=true}) end
            if cfg.WHShowTime  then table.insert(fields,{name="Time",value=fmtTime(tick()-levelUpTime),inline=true}) end
        elseif kind=="event" then
            table.insert(fields,{name="Event",value=tostring(extra),inline=true})
        end
        local titles = {levelup="level up",event="event spotted",test="test ping"}
        local colors  = {levelup=0x00C8FF,event=0x9B6EF5,test=0x2ECC71}
        pcall(httpPost, cfg.WebhookURL, HTTP:JSONEncode({
            username="lunar x",
            embeds={{
                title=titles[kind] or "ping",
                color=colors[kind] or 0x00C8FF,
                fields=fields,
                footer={text="lunar x · fisch"},
            }}
        }))
    end)
end

