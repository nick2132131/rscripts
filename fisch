local function mkCollapsible(parent, label, isEvent, openDefault)
    local ec = isEvent and C.PURPLE or C.ACC2
    local wrap = Instance.new("Frame", parent)
    wrap.Size=UDim2.new(1,0,0,0); wrap.BackgroundTransparency=1
    wrap.AutomaticSize=Enum.AutomaticSize.Y
    local wl=Instance.new("UIListLayout",wrap); wl.SortOrder=Enum.SortOrder.LayoutOrder; wl.Padding=UDim.new(0,3)

    local hdr = Instance.new("TextButton", wrap)
    hdr.Size=UDim2.new(1,0,0,30); hdr.LayoutOrder=0
    hdr.BackgroundColor3=isEvent and rgb(16,10,28) or C.CARD2
    hdr.BorderSizePixel=0; hdr.AutoButtonColor=false; corner(hdr,8); stroke(hdr,C.BORDER)

    local hdrLine=Instance.new("Frame",hdr); hdrLine.Size=UDim2.new(0,3,0,14); hdrLine.Position=UDim2.new(0,8,0.5,-7)
    hdrLine.BackgroundColor3=ec; hdrLine.BorderSizePixel=0; corner(hdrLine,2)

    local hdrLbl=Instance.new("TextLabel",hdr); hdrLbl.Size=UDim2.new(1,-50,1,0); hdrLbl.Position=UDim2.new(0,18,0,0)
    hdrLbl.BackgroundTransparency=1; hdrLbl.Font=Enum.Font.GothamBold; hdrLbl.TextSize=10
    hdrLbl.TextColor3=ec:Lerp(C.TXT,0.35); hdrLbl.TextXAlignment=Enum.TextXAlignment.Left
    hdrLbl.Text=label:upper()

    local arrow=Instance.new("TextLabel",hdr); arrow.Size=UDim2.new(0,22,1,0); arrow.Position=UDim2.new(1,-26,0,0)
    arrow.BackgroundTransparency=1; arrow.Font=Enum.Font.GothamBold; arrow.TextSize=11
    arrow.TextColor3=C.SUB; arrow.Text=openDefault and "▾" or "▸"

    local content=Instance.new("Frame",wrap); content.Size=UDim2.new(1,0,0,0)
    content.LayoutOrder=1; content.BackgroundTransparency=1
    content.AutomaticSize=Enum.AutomaticSize.Y; content.Visible=openDefault
