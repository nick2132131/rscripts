local function getBoat()
    local h=hum() if not h then return nil end
    local seat=h.SeatPart if not seat then return nil end
    local m=seat:FindFirstAncestorWhichIsA("Model")
    return (m and m~=workspace) and m or nil
end

local function getBoatRoot(b)
    if not b then return nil end
    if b.PrimaryPart then return b.PrimaryPart end
    local best,bv=nil,0
    for _,p in b:GetDescendants() do
        if p:IsA("BasePart") then
            local v=p.Size.X*p.Size.Y*p.Size.Z
            if v>bv then best=p; bv=v end
        end
    end
    return best
end

