local function notify(t, b)
    pcall(function() SGui:SetCore("SendNotification",{Title=t,Text=b,Duration=4}) end)
end

local function useInteractable(name)
    local h = hrp()
    if not h then dbg("useInteractable: no hrp"); return end
    local model = findInteractable(name)
    if not model then
        notify("shop", name.." not found")
        dbg("shop: "..name.." not in workspace")
        return
    end
    local cf = getCF(model)
    if not cf then notify("shop","couldn't locate "..name); return end
    returnCF = h.CFrame
    h.CFrame = cf * CFrame.new(0, 4, 5)
    dbg("shop: tp to "..name)
    if returnBtnFrame then returnBtnFrame.Visible = true end
    task.wait(0.5)
    VIM:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
    task.wait(0.15)
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    dbg("shop: pressed E on "..name)
end

