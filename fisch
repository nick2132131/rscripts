zoneWrap.Size=UDim2.new(1,0,0,0); zoneWrap.AutomaticSize=Enum.AutomaticSize.Y; vl(zoneWrap,3)
local normalList=mkCollapse(zoneWrap,"zones",false,true)
local eventList =mkCollapse(zoneWrap,"event zones",true,true)

local function populateZones()
    for _,ch in normalList:GetChildren() do if ch:IsA("TextButton") then ch:Destroy() end end
    for _,ch in eventList:GetChildren()  do if ch:IsA("TextButton") then ch:Destroy() end end
    local q=searchTB.Text:lower(); local seen={}
    local function addLoc(name,cf,isEv)
        if seen[name] or not cf then return end
        if q~="" and not name:lower():find(q,1,true) then return end
        seen[name]=true
        mkEntry(isEv and eventList or normalList,name,isEv,function()
            local h=hrp() if h then h.CFrame=cf+Vector3.new(0,8,0); notify("tp",name); dbg("tp: "..name) end
        end)
    end
    local zones=workspace:FindFirstChild("zones")
    if zones then
        local pz=zones:FindFirstChild("player"); local fz=zones:FindFirstChild("fishing")
        if pz then for _,z in pz:GetChildren() do addLoc(z.Name,getCF(z),false) end end
        if fz then for _,z in fz:GetChildren() do addLoc(z.Name,getCF(z),true)  end end
    end
    local world=workspace:FindFirstChild("world")
    local evF=world and world:FindFirstChild("events")
    if evF then for _,e in evF:GetChildren() do addLoc(e.Name,getCF(e),true) end end
end

searchTB.FocusLost:Connect(populateZones)
