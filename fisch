local function switchTab(idx)
    activeTab=idx
    for _,t in tabs do
        local on=t.idx==idx
        if on then
            tw(t.btn,.12,{BackgroundColor3=ACC, TextColor3=rgb(255,255,255), BackgroundTransparency=0})
        else
            tw(t.btn,.12,{BackgroundColor3=EL, TextColor3=SUB, BackgroundTransparency=1})
        end
        t.page.Visible=on
    end
end

local function newTab(def)
    local btn=Instance.new("TextButton",sCont)
    btn.Size=UDim2.new(1,0,0,32); btn.LayoutOrder=def.idx
    btn.BackgroundColor3=EL; btn.BackgroundTransparency=1
    btn.Text=def.n; btn.Font=Enum.Font.GothamMedium; btn.TextSize=13
    btn.TextColor3=SUB; btn.AutoButtonColor=false; btn.BorderSizePixel=0
    btn.TextXAlignment=Enum.TextXAlignment.Left
    cr(btn,6); pd(btn,0,0,12)

    local page=Instance.new("ScrollingFrame",pHolder)
    page.Size=UDim2.new(1,0,1,0); page.BackgroundTransparency=1
    page.Visible=false; page.ScrollBarThickness=2
    page.ScrollBarImageColor3=ACC; page.AutomaticCanvasSize=Enum.AutomaticSize.Y
    page.CanvasSize=UDim2.new(0,0,0,0); page.BorderSizePixel=0
    page.ScrollingDirection=Enum.ScrollingDirection.Y
    vl(page,6); pd(page,12,12,14,14)

    btn.MouseEnter:Connect(function()
        if def.idx~=activeTab then tw(btn,.1,{BackgroundTransparency=0,BackgroundColor3=ELH,TextColor3=TXT}) end
    end)
    btn.MouseLeave:Connect(function()
        if def.idx~=activeTab then tw(btn,.1,{BackgroundTransparency=1,TextColor3=SUB}) end
    end)
    btn.MouseButton1Click:Connect(function() switchTab(def.idx) end)

    table.insert(tabs,{btn=btn,page=page,idx=def.idx})
    return page
end

