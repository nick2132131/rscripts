local function findInteractable(name)
    local function check(parent)
        return parent and parent:FindFirstChild(name)
    end
    local world = workspace:FindFirstChild("world")
    local ints  = world and world:FindFirstChild("interactables")
    return check(ints) or check(workspace)
end

local function useInteractable(name)
    local model = findInteractable(name)
    if not model then notify("shop", name.." not in workspace") return end
    local h   = hrp()
    if not h then return end
    local savedCF = h.CFrame
    local cf = getCF(model)
    if not cf then notify("shop","couldn't get position") return end

    h.CFrame = cf * CFrame.new(0, 3, 4)
    task.wait(0.45)

    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function() fireproximityprompt(prompt) end)
    else
        VIM:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.12)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
    task.wait(0.25)
    h.CFrame = savedCF
    notify("shop", "used "..name)
end

