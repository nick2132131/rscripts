local function mkSlider(parent,label,mn,mx,def,cb,ac)
    local ac=ac or ACC
    local f=mkRow(parent,56)

    local hdr=Instance.new("Frame",f); hdr.Size=UDim2.new(1,-14,0,20); hdr.Position=UDim2.new(0,14,0,8); hdr.BackgroundTransparency=1; hl(hdr,0)
    local lbL=Instance.new("TextLabel",hdr); lbL.Size=UDim2.new(1,-50,1,0); lbL.BackgroundTransparency=1; lbL.Text=label; lbL.Font=Enum.Font.GothamMedium; lbL.TextSize=12; lbL.TextColor3=TXT; lbL.TextXAlignment=Enum.TextXAlignment.Left
    local vLbl=Instance.new("TextLabel",hdr); vLbl.Size=UDim2.new(0,44,1,0); vLbl.BackgroundTransparency=1; vLbl.Text=tostring(def); vLbl.Font=Enum.Font.GothamBold; vLbl.TextSize=12; vLbl.TextColor3=ac; vLbl.TextXAlignment=Enum.TextXAlignment.Right

    local trackBG=Instance.new("TextButton",f)
    trackBG.Size=UDim2.new(1,-28,0,4); trackBG.Position=UDim2.new(0,14,0,42)
    trackBG.BackgroundColor3=DIM; trackBG.Text=""; trackBG.BorderSizePixel=0; cr(trackBG,2)

    local fill=Instance.new("Frame",trackBG)
    fill.Size=UDim2.new((def-mn)/(mx-mn),0,1,0); fill.BackgroundColor3=ac; fill.BorderSizePixel=0; cr(fill,2)

    local thumb=Instance.new("Frame",trackBG)
    thumb.Size=UDim2.new(0,12,0,12); thumb.AnchorPoint=Vector2.new(.5,.5)
    thumb.Position=UDim2.new((def-mn)/(mx-mn),0,.5,0)
    thumb.BackgroundColor3=TXT; thumb.BorderSizePixel=0; cr(thumb,6)

    local drag=false
    local function upd()
        local pct=math.clamp((UIS:GetMouseLocation().X-trackBG.AbsolutePosition.X)/trackBG.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(pct,0,1,0); thumb.Position=UDim2.new(pct,0,.5,0)
        local v=math.floor(mn+pct*(mx-mn)); vLbl.Text=tostring(v); cb(v)
    end
    trackBG.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true; upd() end end)
    UIS.InputEnded:Connect(function(i)    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    UIS.InputChanged:Connect(function(i)  if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd() end end)
    f.MouseEnter:Connect(function() tw(f,.1,{BackgroundColor3=ELH}) end)
    f.MouseLeave:Connect(function() tw(f,.1,{BackgroundColor3=EL})  end)
end

