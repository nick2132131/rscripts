local function findStarCraters()
    local found={}
    local function scanParent(p)
        for _,v in p:GetChildren() do
            local n=v.Name:lower()
            if n:find("star crater",1,true) or n:find("starcrater",1,true) then
                table.insert(found,v)
            end
            if v:IsA("Model") or v:IsA("Folder") then scanParent(v) end
        end
    end
    local world=workspace:FindFirstChild("world")
    local ints=world and world:FindFirstChild("interactables")
    if ints then scanParent(ints) end
    scanParent(workspace)
    return found
end

local function fireCrater(model)
    local h=hrp(); if not h or not model or not model.Parent then return end
    local cf=getCF(model); if not cf then return end
    h.CFrame=cf*CFrame.new(0,2,2); task.wait(1.5)
    local prompt=nil
    for _,d in model:GetDescendants() do
        if d:IsA("ProximityPrompt") then prompt=d; break end
    end
    if prompt then
        if fireproximityprompt then
            pcall(fireproximityprompt,prompt); task.wait(2); return
        end
    end
    VIM:SendKeyEvent(true, Enum.KeyCode.E,false,game); task.wait(0.2)
    VIM:SendKeyEvent(false,Enum.KeyCode.E,false,game); task.wait(2)
end

local function doServerHop()
    pcall(function()
        saveHopFlag(true)
        saveCfg(); saveSlots(); saveFarmCount()

        local HttpParent = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        local function GetNextPage(cursor)
            local url = HttpParent .. (cursor and "&cursor=" .. cursor or "")
            local ok, raw = pcall(game.HttpGet, game, url)
            if ok then return HTTP:JSONDecode(raw) end
            return nil
        end

        local cursor = nil
        local possibleServers = {}

        for i = 1, 5 do 
            local data = GetNextPage(cursor)
            if not data or not data.data then break end

            for _, s in pairs(data.data) do
                if s.id ~= game.JobId and (s.playing or 0) < 17 then
                    table.insert(possibleServers, s.id)
                end
            end

            cursor = data.nextPageCursor
            if not cursor then break end
            task.wait(0.1)
        end

        local qot = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        local function executeQOT()
            if qot then
                pcall(qot, 'loadstring(game:HttpGet("https://raw.githubusercontent.com/nick2132131/rscripts/refs/heads/main/fisch"))()')
                task.wait(1) 
            end
        end

        if #possibleServers > 0 then
            local randomId = possibleServers[math.random(1, #possibleServers)]
            dbg("serverhop → " .. randomId:sub(1, 8) .. " (Randomly picked from " .. #possibleServers .. " options)")
            executeQOT()
            TeleServ:TeleportToPlaceInstance(game.PlaceId, randomId, lp)
        else
            dbg("serverhop: no specific servers found, falling back")
            saveHopFlag(false)
            executeQOT()
            TeleServ:Teleport(game.PlaceId, lp)
        end
    end)
end

local starFarmRunning = false
local starFarmStatus  = ""
local starStatusLbl   = nil
local starStatusDot   = nil

task.spawn(function()
    task.wait(STARTUP_DELAY)
    if popHopFlag() then
        starCraterServerCount = starCraterServerCount + 1
        saveFarmCount()
        sendWebhook("autofarm")
        dbg("arrived on new server — total: "..starCraterServerCount)
        if starStatusLbl then starStatusLbl.Text = "server #"..starCraterServerCount.." — ready" end
    end
    while _G.__lx and task.wait(0.5) do
        if not cfg.AutoStarCrater then
            if starFarmRunning then
                starFarmRunning = false
                if starStatusLbl then starStatusLbl.Text = "idle" end
                if starStatusDot then TS:Create(starStatusDot,TweenInfo.new(0.3),{BackgroundColor3=T.dim}):Play() end
            end
            continue
        end
        if starFarmRunning then continue end
        starFarmRunning = true
        local craters = findStarCraters()
        dbg("starcrater: "..#craters.." craters found")
        if #craters == 0 then
            starFarmStatus = "no craters — hopping..."
            if starStatusLbl then starStatusLbl.Text = starFarmStatus end
            if starStatusDot then TS:Create(starStatusDot,TweenInfo.new(0.3),{BackgroundColor3=T.yell}):Play() end
            task.wait(1)
            if cfg.AutoStarCrater and cfg.StarCraterServerHop then
                saveHopFlag(false)
                doServerHop()
                task.wait(30)
                dbg("starcrater: empty-server hop timed out")
            end
            starFarmRunning = false
            continue
        end
        for i,crater in craters do
            if not cfg.AutoStarCrater or not _G.__lx then break end
            starFarmStatus = "crater "..i.."/"..#craters
            if starStatusLbl then starStatusLbl.Text = starFarmStatus end
            if starStatusDot then TS:Create(starStatusDot,TweenInfo.new(0.3),{BackgroundColor3=T.green}):Play() end
            dbg("starcrater: farming #"..i.."  "..crater.Name)
            fireCrater(crater)
            task.wait(1.5)
        end
        if not cfg.AutoStarCrater or not _G.__lx then starFarmRunning = false; continue end
        starFarmStatus = "done — hopping..."
        if starStatusLbl then starStatusLbl.Text = starFarmStatus end
        dbg("starcrater: cycle done, hopping...")
        task.wait(1)
        if cfg.StarCraterServerHop then
            doServerHop()
            task.wait(30)
            saveHopFlag(false)
            dbg("starcrater: hop timed out, retrying")
            notify("farm","server hop failed — retrying")
        else
            starCraterServerCount = starCraterServerCount + 1
            saveFarmCount()
            sendWebhook("autofarm")
            dbg("starcrater: cycle credited — total: "..starCraterServerCount)
        end
        starFarmRunning = false
    end
end)

