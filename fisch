    p.PaddingTop=UDim.new(0,a); p.PaddingBottom=UDim.new(0,b or a)
    p.PaddingLeft=UDim.new(0,c or a); p.PaddingRight=UDim.new(0,d or c or a)
end
local function vl(i,g)
    local l=Instance.new("UIListLayout",i)
    l.Padding=UDim.new(0,g or 4); l.SortOrder=Enum.SortOrder.LayoutOrder; return l
end
local function hl(i,g)
    local l=Instance.new("UIListLayout",i)
    l.FillDirection=Enum.FillDirection.Horizontal; l.Padding=UDim.new(0,g or 4)
    l.SortOrder=Enum.SortOrder.LayoutOrder; l.VerticalAlignment=Enum.VerticalAlignment.Center; return l
end
local function tw(inst,t,props)
