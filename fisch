    waterPart             = Instance.new("Part")
    waterPart.Name        = "_lxWater"
    waterPart.Size        = Vector3.new(80,0.05,80)
    waterPart.Anchored    = true
    waterPart.CanCollide  = true
    waterPart.Transparency= 1
    waterPart.CastShadow  = false
    waterPart.CanTouch    = false
    waterPart.Parent      = workspace
    waterY = nil
    walkConn = RunService.Heartbeat:Connect(function()
        local h = hrp()
        if not h or not cfg.WalkOnWater then return end
        local state = hum() and hum():GetState()
        if state == Enum.HumanoidStateType.Swimming then
            waterY = h.Position.Y - 2.5
        elseif not waterY then
            waterY = h.Position.Y - 2.9
        end
        waterPart.CFrame = CFrame.new(h.Position.X, waterY, h.Position.Z)
