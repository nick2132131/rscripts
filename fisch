local function tryBuy(itemId, qty)
    local ok = false
    pcall(function()
        local Net = require(RepStore:WaitForChild("packages"):WaitForChild("Net"))
        local r   = Net:RemoteFunction("Shop/Purchase")
        r:InvokeServer({action="buy",itemId=itemId,quantity=qty or 1})
        ok = true
    end)
    if not ok then
        pcall(function()
            for _,v in RepStore:GetDescendants() do
                if (v:IsA("RemoteFunction") or v:IsA("RemoteEvent")) and
                   (v.Name:lower():find("shop") or v.Name:lower():find("buy") or v.Name:lower():find("purchase")) then
                    if v:IsA("RemoteFunction") then
                        v:InvokeServer({action="buy",itemId=itemId,quantity=qty or 1})
                    else
                        v:FireServer({action="buy",itemId=itemId,quantity=qty or 1})
                    end
                    ok=true; break
                end
            end
        end)
    end
    return ok
end

