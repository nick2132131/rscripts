local function mkToggle(parent, label, sublabel, default, cb, accentCol)
    local row = mkCard(parent, sublabel and 42 or 36)
    local ac  = accentCol or C.ACC

    local lb = Instance.new("TextLabel", row)
    lb.Size=UDim2.new(1,-60,0,18); lb.Position=UDim2.new(0,14,0,sublabel and 6 or 9)
    lb.BackgroundTransparency=1; lb.Text=label
    lb.Font=Enum.Font.GothamMedium; lb.TextSize=12
    lb.TextColor3=C.TXT; lb.TextXAlignment=Enum.TextXAlignment.Left

    if sublabel then
        local sl = Instance.new("TextLabel", row)
        sl.Size=UDim2.new(1,-60,0,13); sl.Position=UDim2.new(0,14,0,22)
        sl.BackgroundTransparency=1; sl.Text=sublabel
        sl.Font=Enum.Font.Gotham; sl.TextSize=10
        sl.TextColor3=C.SUB; sl.TextXAlignment=Enum.TextXAlignment.Left
    end

    local track = Instance.new("Frame", row)
    track.Size=UDim2.new(0,40,0,22); track.Position=UDim2.new(1,-52,0.5,-11)
    track.BackgroundColor3=default and ac or C.DIM
    track.BorderSizePixel=0; corner(track,11)

    local knob = Instance.new("Frame", track)
    knob.Size=UDim2.new(0,18,0,18)
    knob.Position=default and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
    knob.BackgroundColor3=C.WHITE; knob.BorderSizePixel=0; corner(knob,9)

    local hit = Instance.new("TextButton", row)
    hit.Size=UDim2.new(1,0,1,0); hit.BackgroundTransparency=1
    hit.Text=""; hit.AutoButtonColor=false; hit.BorderSizePixel=0

    local state = default
    hit.MouseButton1Click:Connect(function()
        state = not state; cb(state)
        TS:Create(track,TweenInfo.new(0.15),{BackgroundColor3=state and ac or C.DIM}):Play()
        TS:Create(knob,TweenInfo.new(0.15),{Position=state and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)}):Play()
    end)
    return row
end

local function mkSlider(parent, label, minv, maxv, default, cb, accentCol)
    local ac = accentCol or C.ACC
    local f = mkCard(parent, 54)
    f.Size = UDim2.new(1,0,0,54)

    local top = Instance.new("TextLabel", f)
    top.Size=UDim2.new(1,-14,0,22); top.Position=UDim2.new(0,14,0,6)
    top.BackgroundTransparency=1; top.Font=Enum.Font.GothamMedium; top.TextSize=12
    top.TextColor3=C.TXT; top.TextXAlignment=Enum.TextXAlignment.Left
    top.Text=label

    local val_lbl = Instance.new("TextLabel", f)
    val_lbl.Size=UDim2.new(0,60,0,22); val_lbl.Position=UDim2.new(1,-70,0,6)
    val_lbl.BackgroundTransparency=1; val_lbl.Font=Enum.Font.GothamBold; val_lbl.TextSize=12
    val_lbl.TextColor3=ac; val_lbl.TextXAlignment=Enum.TextXAlignment.Right
    val_lbl.Text=tostring(default)

    local trackBG = Instance.new("TextButton", f)
    trackBG.Size=UDim2.new(1,-28,0,5); trackBG.Position=UDim2.new(0,14,0,40)
    trackBG.BackgroundColor3=C.DIM; trackBG.Text=""; trackBG.BorderSizePixel=0; corner(trackBG,3)

    local fill = Instance.new("Frame", trackBG)
    fill.Size=UDim2.new((default-minv)/(maxv-minv),0,1,0)
    fill.BackgroundColor3=ac; fill.BorderSizePixel=0; corner(fill,3)

    local knob = Instance.new("Frame", trackBG)
    local kpct = (default-minv)/(maxv-minv)
    knob.Size=UDim2.new(0,11,0,11); knob.AnchorPoint=Vector2.new(0.5,0.5)
    knob.Position=UDim2.new(kpct,0,0.5,0)
    knob.BackgroundColor3=C.WHITE; knob.BorderSizePixel=0; corner(knob,6)
    stroke(knob,ac:Lerp(C.WHITE,0.3),1)

    local drag=false
    local function upd()
        local pct=math.clamp((UIS:GetMouseLocation().X-trackBG.AbsolutePosition.X)/trackBG.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(pct,0,1,0)
        knob.Position=UDim2.new(pct,0,0.5,0)
        local v=math.floor(minv+pct*(maxv-minv))
        val_lbl.Text=tostring(v); cb(v)
    end
    trackBG.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true; upd() end end)
    UIS.InputEnded:Connect(function(i)     if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    UIS.InputChanged:Connect(function(i)   if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd() end end)
end

