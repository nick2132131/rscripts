local function switchTab(idx)
    activeTabIdx = idx
    for _, t in tabs do
        local on = t.idx == idx
        TS:Create(t.btn,TweenInfo.new(0.12),{
            BackgroundColor3 = on and C.CARD2 or Color3.new(0,0,0),
            BackgroundTransparency = on and 0 or 1,
        }):Play()
        t.iconL.TextColor3 = on and C.ACC or C.SUB
        t.page.Visible = on
    end
end

local function newTab(def)
    local btn = Instance.new("TextButton", sidebar)
    btn.Size = UDim2.new(0,42,0,42); btn.LayoutOrder=def.idx
    btn.BackgroundColor3=C.CARD2; btn.BackgroundTransparency=1
    btn.Text=""; btn.AutoButtonColor=false; btn.BorderSizePixel=0
    corner(btn,8)

    local iconL = Instance.new("TextLabel", btn)
    iconL.Size = UDim2.new(1,0,0,22); iconL.Position = UDim2.new(0,0,0,4)
    iconL.BackgroundTransparency=1; iconL.Text=def.icon
    iconL.Font=Enum.Font.GothamBold; iconL.TextSize=16
    iconL.TextColor3=C.SUB; iconL.TextXAlignment=Enum.TextXAlignment.Center

    local lblL = Instance.new("TextLabel", btn)
    lblL.Size = UDim2.new(1,-2,0,12); lblL.Position = UDim2.new(0,1,1,-14)
    lblL.BackgroundTransparency=1; lblL.Text=def.label
    lblL.Font=Enum.Font.Gotham; lblL.TextSize=8
    lblL.TextColor3=C.DIM; lblL.TextXAlignment=Enum.TextXAlignment.Center
    lblL.TextTruncate=Enum.TextTruncate.AtEnd

    local page = Instance.new("ScrollingFrame", pageHolder)
    page.Size=UDim2.new(1,0,1,0); page.BackgroundTransparency=1
    page.Visible=(def.idx==0); page.ScrollBarThickness=2
    page.ScrollBarImageColor3=C.ACC2; page.AutomaticCanvasSize=Enum.AutomaticSize.Y
    page.CanvasSize=UDim2.new(0,0,0,0); page.BorderSizePixel=0
    page.ScrollingDirection=Enum.ScrollingDirection.Y
    vlist(page,5); pad(page,12,12,12,12)

    btn.MouseButton1Click:Connect(function() switchTab(def.idx) end)
    btn.MouseEnter:Connect(function()
        if def.idx ~= activeTabIdx then
            TS:Create(btn,TweenInfo.new(0.1),{BackgroundTransparency=0,BackgroundColor3=C.DIM}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if def.idx ~= activeTabIdx then
            TS:Create(btn,TweenInfo.new(0.1),{BackgroundTransparency=1}):Play()
        end
    end)

    table.insert(tabs, {btn=btn,iconL=iconL,page=page,idx=def.idx})
    return page
end

