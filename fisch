local function refreshPlayers()
    for _,ch in plFrame:GetChildren() do if ch:IsA("TextButton") then ch:Destroy() end end
    local n=0
    for _,p in Players:GetPlayers() do
        if p==lp then continue end; n=n+1
        mkEntry(plFrame,p.Name,false,function()
            local tgt=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local h=hrp()
            if h and tgt then h.CFrame=tgt.CFrame+Vector3.new(0,3,0); notify("tp",p.Name) end
        end)
    end
    if n==0 then
        local lb=Instance.new("TextLabel",plFrame); lb.Size=UDim2.new(1,0,0,24)
        lb.BackgroundTransparency=1; lb.Text="no other players"; lb.Font=Enum.Font.Gotham
        lb.TextSize=11; lb.TextColor3=C.SUB; lb.TextXAlignment=Enum.TextXAlignment.Left
    end
end
