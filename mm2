	local script = Instance.new('LocalScript', FakeLag)

	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local LagBtn = script.Parent
	local LagBox = script.Parent.LagValue
	local frame = LagBtn.Frame
	
	local activeColor = Color3.fromRGB(8, 197, 20)
	local inactiveColor = Color3.fromRGB(217, 0, 4)
	
	local fakeLag = false
	local delayValue = 0.25
	
	local function getCharacter()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		local hum = char:WaitForChild("Humanoid", 5)
		return char, hrp, hum
	end
	
	local function startFakeLag()
		task.spawn(function()
			while fakeLag do
				local char, hrp, hum = getCharacter()
	
				if not hum or hum.Health <= 0 then
					repeat
						task.wait()
						char, hrp, hum = getCharacter()
					until hum and hum.Health > 0
				end
	
				if hrp then
					hrp.Anchored = true
					task.wait(delayValue)
					hrp.Anchored = false
				end
	
				task.wait(0.05)
			end
		end)
	end
	
	LagBtn.MouseButton1Click:Connect(function()
		fakeLag = not fakeLag
		frame.BackgroundColor3 = fakeLag and activeColor or inactiveColor
	
		if fakeLag then
			delayValue = tonumber(LagBox.Text) or 0.25
			startFakeLag()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		if fakeLag then
			task.wait(0.25)
			startFakeLag()
		end
	end)
	
	LagBox:GetPropertyChangedSignal("Text"):Connect(function()
		local newValue = tonumber(LagBox.Text)
		if newValue and newValue > 0 then
			delayValue = newValue
		end
	end)
	
