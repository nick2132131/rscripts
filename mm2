	local originalColor = frame.BackgroundColor3
	local godmodeColor = Color3.fromRGB(8, 197, 20)
	local godmodeEnabled = false
	local connections = {}
	local forcefield
	local oldMetatable
	
	local function protectWithMetatable(humanoid)
	
		oldMetatable = getrawmetatable(humanoid)
		setreadonly(oldMetatable, false)
	
		local oldIndex = oldMetatable.__index
		local oldNamecall = oldMetatable.__namecall
	
		oldMetatable.__index = newcclosure(function(self, key)
			if self == humanoid and key == "Health" then
				return humanoid.MaxHealth
			end
			return oldIndex(self, key)
		end)
	
		oldMetatable.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
	
			if self == humanoid then
				if method == "TakeDamage" then
					return nil 
				elseif method == "Destroy" then
					return nil 
				end
			end
	
			return oldNamecall(self, ...)
		end)
	
		setreadonly(oldMetatable, true)
	end
	
	local function enableGodmode(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if not humanoid then return end
	
		humanoid.MaxHealth = 1e6
		humanoid.Health = humanoid.MaxHealth
	
		local success, err = pcall(protectWithMetatable, humanoid)
		if not success then
			warn("Metatable protection failed:", err)
		end
	
		if connections.health then connections.health:Disconnect() end
		connections.health = humanoid.HealthChanged:Connect(function()
			if humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
	
		if connections.render then connections.render:Disconnect() end
		connections.render = RunService.RenderStepped:Connect(function()
			if humanoid and humanoid.Parent then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
	
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	
		if connections.stateChanged then connections.stateChanged:Disconnect() end
		connections.stateChanged = humanoid.StateChanged:Connect(function(old, new)
			if new == Enum.HumanoidStateType.Dead then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	
		if connections.dying then connections.dying:Disconnect() end
		connections.dying = humanoid.Dying:Connect(function()
			humanoid.Health = humanoid.MaxHealth
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	
		if not forcefield then
			forcefield = Instance.new("ForceField")
			forcefield.Visible = false
			forcefield.Parent = character
		end
	
		if connections.descendant then connections.descendant:Disconnect() end
		connections.descendant = character.DescendantRemoving:Connect(function(descendant)
			if descendant == humanoid or descendant.Name == "Head" then
	
				task.wait()
				if humanoid and humanoid.Parent then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)
	
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			if connections.ancestryChanged then connections.ancestryChanged:Disconnect() end
			connections.ancestryChanged = hrp.AncestryChanged:Connect(function()
				if not hrp.Parent and character.Parent then
	
					task.wait(0.1)
					if humanoid and humanoid.Parent then
						humanoid.Health = humanoid.MaxHealth
					end
				end
			end)
		end
	end
	
	local function disableGodmode(character)
	
		for _, connection in pairs(connections) do
			if connection then connection:Disconnect() end
		end
		connections = {}
	
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.MaxHealth = 100
			humanoid.Health = 100
			humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
		end
	
		if oldMetatable then
			local success = pcall(function()
				setreadonly(getrawmetatable(game), false)
				setreadonly(getrawmetatable(game), true)
			end)
		end
	
		if forcefield then
			forcefield:Destroy()
			forcefield = nil
		end
	end
	
	button.MouseButton1Click:Connect(function()
		godmodeEnabled = not godmodeEnabled
		frame.BackgroundColor3 = godmodeEnabled and godmodeColor or originalColor
	
		local character = LocalPlayer.Character
		if character then
			if godmodeEnabled then
				enableGodmode(character)
			else
				disableGodmode(character)
			end
		end
	end)
	
	LocalPlayer.CharacterAdded:Connect(function(character)
		if godmodeEnabled then
			task.wait(0.1)
			enableGodmode(character)
		end
	end)
