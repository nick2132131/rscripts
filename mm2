		if tooltip.Visible then
			tooltip.Position = UDim2.new(0, Mouse.X + 10, 0, Mouse.Y - 4.5)
		end
	end)
	
	local function attachHoverEvents(guiObject)
		if guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("ImageButton") then
			guiObject.MouseEnter:Connect(function()
				currentHover = guiObject
				hoverStartTime = tick()
	
				task.delay(tooltipDelay, function()
					if currentHover == guiObject then
						local desc = descriptions[guiObject.Name]
						if desc then
							tooltip.Text = desc
							tooltip.Visible = true
						end
					end
				end)
			end)
	
			guiObject.MouseLeave:Connect(function()
				if currentHover == guiObject then
					currentHover = nil
					tooltip.Visible = false
				end
			end)
		end
	end
	
	for _, descendant in ipairs(script.Parent:GetDescendants()) do
		attachHoverEvents(descendant)
	end
	
	script.Parent.DescendantAdded:Connect(function(obj)
		attachHoverEvents(obj)
	end)
	
