		DetectOriginalSheriff()
	
		local localChar = LocalPlayer.Character
		local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
		if not tracerESPEnabled or not localHRP then
			for _, v in pairs(Tracers) do
				v.Visible = false
			end
			return
		end
	
