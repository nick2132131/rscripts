	local XrayEnabled = false
	local TransparencyAmount = 0.3
	local MaterialType = Enum.Material.ForceField
	local SavedProperties = {}
	
	local function isPlayerPart(part)
		for _, player in pairs(game.Players:GetPlayers()) do
			if player.Character and part:IsDescendantOf(player.Character) then
				return true
			end
		end
		return false
	end
	
	local function setXray(state)
		for _, obj in pairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not isPlayerPart(obj) then
				if state then
					if not SavedProperties[obj] then
						SavedProperties[obj] = {
							Transparency = obj.Transparency,
							Material = obj.Material
						}
					end
					obj.Transparency = TransparencyAmount
					obj.Material = MaterialType
				else
					if SavedProperties[obj] then
						obj.Transparency = SavedProperties[obj].Transparency
						obj.Material = SavedProperties[obj].Material
					end
				end
			end
		end
	
		if not state then
			SavedProperties = {}
		end
	end
	
	local frame2 = script.Parent.Frame
	
	toggleButton.MouseButton1Click:Connect(function()
		XrayEnabled = not XrayEnabled
		frame2.BackgroundColor3 = XrayEnabled and activeColor or inactiveColor
	
		setXray(XrayEnabled)
	end)
	
	local frame = script.Parent.Parent.sliderBackFrame
	local sliderFrame = frame.sliderInFrame
	local sliderKnob = sliderFrame.sliderKnob
	local opacityLabel = frame.opaLabel
	
	local function updateSlider(positionX)
		local minX = 0
		local maxX = sliderFrame.Parent.AbsoluteSize.X - sliderKnob.AbsoluteSize.X
		local clampedX = math.clamp(positionX, minX, maxX)
		sliderKnob.Position = UDim2.new(0, clampedX, -0.7, 0)
	
		-- Map knob position to transparency (0.1 to 1)
		local t = clampedX / maxX
		TransparencyAmount = 1 - (t * 0.9) -- Range from 0.1 to 1
		opacityLabel.Text = string.format("Opacity: %.0f%%", (1 - TransparencyAmount) * 100)
	
		-- Resize sliderInFrame to match knob position
		local minSize = 0 * sliderFrame.Parent.AbsoluteSize.X -- 10% at min transparency
		local newSizeX = minSize + clampedX - -5 -- Grow to knob's X position
		sliderFrame.Size = UDim2.new(0, newSizeX, 0, sliderFrame.Size.Y.Offset)
	
		if XrayEnabled then
			setXray(true)
		end
	end
	
	local dragging = false
	sliderKnob.MouseButton1Down:Connect(function()
		dragging = true
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local mousePos = UserInputService:GetMouseLocation()
			local framePos = sliderFrame.Parent.AbsolutePosition
			local relativeX = mousePos.X - framePos.X
			updateSlider(relativeX)
		end
	end)
	
	-- Initialize slider
	updateSlider((1 - TransparencyAmount) / 0.9 * (sliderFrame.Parent.AbsoluteSize.X - sliderKnob.AbsoluteSize.X))
end
