	local function TrackPlayer(player)
		local function TrackChar(char)
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					if player==OriginalSheriff then
						OriginalSheriff=nil
						DetectOriginalSheriff()
					end
				end)
			end
		end
		if player.Character then TrackChar(player.Character) end
		player.CharacterAdded:Connect(TrackChar)
		player:WaitForChild("Backpack").ChildRemoved:Connect(function(child)
			if child.Name=="Gun" and player==OriginalSheriff then
				OriginalSheriff=nil
				DetectOriginalSheriff()
			end
		end)
